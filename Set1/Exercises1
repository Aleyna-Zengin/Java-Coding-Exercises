Sum of Squares of First N Numbers
// My answer
public class SumOfSquares {
    public long calculateSumOfSquares(int n) {
       int i;
       int sum = 0;
       for(i=0; i<=n; i++){
           System.out.printf("%d * %d = %d", i, i, i*i).println(); //Prints all operations
           sum += (i*i);
           System.out.printf("%d", sum).println(); //After all operations writes the final sum
       }
       
       
       if(n<0){
           return -1; // if n is below 0 it is wrong
       }
       else {return sum;} // if not it is the sum
       
    }
}


